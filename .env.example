# JobRunner configuration.
#
#   cp .env.example .env
#   mix phx.server        # this file is loaded at boot; no `source` needed
#
# Everything is optional — unset values fall back to config/config.exs. An
# exported shell variable overrides this file.


# --- Provider ----------------------------------------------------------------
# One switch. It sets the protocol dialect (token parameter, temperature
# handling, vLLM-only fields) as well as the endpoint, so the swap is atomic.
LLM_PROVIDER=openai            # vllm | openai

# vLLM (LLM_PROVIDER=vllm). Defaults shown; override to retarget.
# VLLM_BASE_URL=http://192.168.84.7:8001
# VLLM_MODEL=Qwen3.6-35B-A3B
# VLLM_API_KEY=not-required

# OpenAI (LLM_PROVIDER=openai).
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-5.5
OPENAI_API_KEY=sk-replace-me


# --- Request limits ----------------------------------------------------------
# Completion budget. 4096 leaves room inside the 32k context alongside a
# 24KB prompt cap. Too small fails the job as :truncated.
# LLM_MAX_TOKENS=4096
# LLM_RECEIVE_TIMEOUT_MS=45000


# --- Engine ------------------------------------------------------------------
# Concurrent LLM calls. Low by default because the vLLM endpoint is shared.
# MAX_CONCURRENCY=4

# Total attempts including the first, so 5 means 4 retries and 4 backoff gaps.
# MAX_ATTEMPTS=5

# First backoff delay, doubling each attempt, with ±25% jitter.
# BACKOFF_BASE_MS=500

# Per-job deadline. Distinct from the HTTP timeout: a wedged adapter or a slow
# parse can outlive that.
# JOB_TIMEOUT_MS=60000

# Admission bound. add_job/1 returns {:error, :queue_full} beyond this.
# MAX_PENDING_JOBS=10000


# --- Circuit breaker ---------------------------------------------------------
# Consecutive endpoint failures before dispatch stops. Set to 999 to disable it,
# which is how you demonstrate jobs exhausting their budgets during an outage —
# with it on they hold at :pending instead.
# BREAKER_THRESHOLD=5
# BREAKER_COOLDOWN_MS=30000
# BREAKER_MAX_COOLDOWN_MS=300000


# --- Web ---------------------------------------------------------------------
# PORT=4000
