# ---------------------------------------------------------------------------
# JobRunner configuration
# ---------------------------------------------------------------------------
#
#   cp .env.example .env      # then fill in your key
#   mix phx.server            # this file is loaded automatically at boot
#
# No `source` step is needed — config/runtime.exs reads this file and prints
# what it loaded. An explicitly exported shell variable still WINS over the
# file, so `MAX_CONCURRENCY=16 mix phx.server` works for one-off overrides.
#
# WARNING: if you have previously run `set -a && . ./.env && set +a` in a
# terminal, those exports override this file — including values you have since
# deleted, because sourcing sets variables but never unsets them. Open a fresh
# terminal if your edits appear to do nothing.
#
# Every value here is OPTIONAL. Anything left unset falls back to the default in
# config/config.exs, which targets the internal endpoint from the brief. This
# file only needs to contain what you want to override.
#
# `.env` is gitignored; `.env.example` is committed. Never put a real key in the
# example.
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. LLM PROVIDER
# ===========================================================================
#
# The internal endpoint and the OpenAI API speak the same wire protocol, so they
# are one adapter with two configs (ADR-008). Switching between them is this
# file, never code.
#
# --- Pick a provider, then set ITS namespaced variables ---------------------
#
# A provider is not one setting, it is two different KINDS of setting:
#
#   protocol dialect     which token parameter, whether a temperature is
#                        accepted, whether vLLM-only fields may be sent.
#                        These are facts about the API, so they live in code
#                        (config/runtime.exs) and you should not need to touch
#                        them.
#
#   deployment values    host, model, credentials. These are yours, they change
#                        per environment, and they live HERE — never in code.
#
# Changing dialect settings one at a time is how you get:
#
#   400 unknown_parameter: Unknown parameter: 'chat_template_kwargs'
#     -> a vLLM-only field sent to OpenAI, which rejects unknown fields
#
#   content:null, finish_reason:"length"
#     -> thinking left enabled on Qwen3, which then never answers
#
# So choose a profile, and override only what is yours.

LLM_PROVIDER=vllm            # vllm | openai

# --- vLLM deployment values (used when LLM_PROVIDER=vllm) -------------------
# Defaults match the brief. Point at any other box or model without touching code.
# VLLM_BASE_URL=http://192.168.84.7:8001
# VLLM_MODEL=Qwen3.6-35B-A3B
# VLLM_API_KEY=not-required          # vLLM ignores it, but it must be non-empty

# --- OpenAI deployment values (used when LLM_PROVIDER=openai) ---------------
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-5.5
OPENAI_API_KEY=sk-replace-me

# --- Cross-provider overrides ------------------------------------------------
# These win over whichever profile is active. Useful for one-off experiments;
# be aware they can produce an incoherent combination (an OpenAI model name
# against the vLLM host, say). The resolved target is printed at boot so any
# mismatch is visible:
#
#   [config] LLM -> http://192.168.84.7:8001 model=Qwen3.6-35B-A3B token_param=:max_tokens
#
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# LLM_TOKEN_PARAM=max_tokens          # or max_completion_tokens
# LLM_TEMPERATURE=0.2                 # or `none` to omit the field entirely
# LLM_ENABLE_THINKING=false           # vLLM only; leave UNSET for OpenAI

# --- Timeouts ---------------------------------------------------------------

# How long to wait for a response body. Generous by default because the brief's
# endpoint is shared and its latency is variable by design.
# Default: 45000
# LLM_RECEIVE_TIMEOUT_MS=45000

# Cap on generated tokens, sized against the 32,768-token context window:
#
#   prompt cap    24,000 bytes  ~=  6,000 tokens   (MAX_PROMPT_BYTES)
#   system prompt                     ~200 tokens
#   completion                       4,096 tokens   (this setting)
#   -----------------------------------------------
#   worst case                     ~10,300 tokens   -- well inside 32,768
#
# Too small is a real failure, not a truncated nicety: an open-ended prompt
# ("tell me about accounting") wants ~1,000 tokens on its own, and the job fails
# with :truncated. Raise this before you suspect the model.
# Default: 4096
# LLM_MAX_TOKENS=4096

# Swap the adapter entirely. Rarely needed — the Mock is selected automatically
# in the test environment.
# Default: JobRunner.LLM.OpenAICompatible
# LLM_ADAPTER=JobRunner.LLM.Mock


# ===========================================================================
# 2. CONCURRENCY
# ===========================================================================

# How many LLM calls may be in flight at once.
#
# The default of 4 is deliberately conservative because the brief's endpoint is
# SHARED with other people. Past the point where the server saturates, more
# concurrency only converts queueing delay into timeouts, and timeouts into
# retries, and retries into more load.
#
# Against your own API key that constraint does not apply — 16 is reasonable.
# An unbounded number of concurrent LLM calls is not a design decision, it's an
# accident.
# Default: 4
# MAX_CONCURRENCY=4

# Reject new jobs beyond this many pending/running. Bounds the VM, where
# MAX_CONCURRENCY bounds the endpoint — two different limits doing two
# different jobs. add_job/1 returns {:error, :queue_full} at the ceiling.
# Default: 10000
# MAX_PENDING_JOBS=10000


# ===========================================================================
# 3. RETRIES AND BACKOFF
# ===========================================================================

# Total attempts per job, INCLUDING the first. 5 means 1 initial attempt plus 4
# retries, and therefore 4 backoff gaps. Named "attempts" rather than "retries"
# to keep that off-by-one visible instead of implicit.
# Default: 5
# MAX_ATTEMPTS=5

# First backoff delay in ms, doubling each attempt: 500, 1s, 2s, 4s.
# Jitter of ±25% is applied on top — without it, a batch that fails together
# retries together and stampedes the endpoint it just overloaded (thundering
# herd). Lower this to ~200 to watch retries without waiting around.
# Default: 500
# BACKOFF_BASE_MS=500

# Per-job deadline. Deliberately NOT the same as LLM_RECEIVE_TIMEOUT_MS: a
# wedged adapter or a slow parse can blow past an HTTP timeout, so the Queue
# arms its own deadline and reclaims the concurrency slot itself.
# Default: 60000
# JOB_TIMEOUT_MS=60000


# ===========================================================================
# 4. CIRCUIT BREAKER
# ===========================================================================
#
# Retry is the right answer to a transient failure and the WRONG answer to a
# sustained outage: without a breaker, every queued job independently burns its
# full budget against a socket that will not answer, and the whole queue drains
# into the dead letter queue.
#
# Only *systemic* failures count toward tripping it — transport errors,
# timeouts, 429, 5xx. A 400 from a bad prompt or a model returning unparseable
# JSON never trips it, or one malformed job could take the system offline.

# Consecutive systemic failures before dispatch is suspended.
#
# Set this to 999 to effectively DISABLE the breaker. That is how you
# demonstrate jobs burning their budgets and dead-lettering during an outage —
# with the breaker on they correctly sit at :pending with attempts frozen, and
# nothing fails at all.
# Default: 5
# BREAKER_THRESHOLD=5

# How long to wait before letting a single probe job through. Doubles on each
# consecutive failed probe. Lower to ~2000 to watch a recovery cycle quickly.
# Default: 30000
# BREAKER_COOLDOWN_MS=30000

# Ceiling on that doubling. Without a cap, a long outage pushes the probe
# interval out to hours and the system takes hours to notice recovery.
# Default: 300000
# BREAKER_MAX_COOLDOWN_MS=300000


# ===========================================================================
# 5. WEB
# ===========================================================================

# Dashboard port. Change it if 4000 is taken.
# Default: 4000
# PORT=4000
